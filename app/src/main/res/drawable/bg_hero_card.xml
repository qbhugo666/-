<?xml version="1.0" encoding="utf-8"?>
<!-- 英雄卡 v0.56.0 新拟物混合风：24dp 圆角、6dp 双阴影渐变（比列表卡更深一档） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 左上高光 -->
    <item android:bottom="6dp" android:right="6dp">
        <shape>
            <gradient android:angle="315" android:startColor="@color/neu_hi" android:endColor="@color/neu_bg" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- 右下暗影 -->
    <item android:top="6dp" android:left="6dp">
        <shape>
            <gradient android:angle="315" android:startColor="@color/neu_bg" android:endColor="@color/neu_lo" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- 表面 -->
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape>
            <solid android:color="@color/neu_bg" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
