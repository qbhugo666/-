<?xml version="1.0" encoding="utf-8"?>
<!-- 新拟物卡片 v0.56.2：表面=背景色，左上高光渐变+右下暗影渐变营造浮起感
     （深浅两版由 values-night 的 neu_hi/neu_lo/neu_bg 配色独立区分） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 表面 -->
    <item>
        <shape>
            <solid android:color="@color/neu_bg" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- 左上高光：白色向透明渐隐 -->
    <item>
        <shape>
            <gradient android:angle="315" android:startColor="#B3FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- 右下暗影：向暗影色渐显 -->
    <item>
        <shape>
            <gradient android:angle="315" android:startColor="#00A3B2CC" android:endColor="#26A3B2CC" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
