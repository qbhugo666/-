<?xml version="1.0" encoding="utf-8"?>
<!-- 滑块圆钮 v0.56.12：凸面白芯——纯白内芯压在蓝线/灰槽上保证可视性，
     边缘环 1.5dp 提供立体感 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="22dp"
        android:height="22dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="@color/neu_rim_hi"
                android:endColor="@color/neu_rim" />
        </shape>
    </item>
    <item
        android:width="19dp"
        android:height="19dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
