<?xml version="1.0" encoding="utf-8"?>
<!-- 滑块圆钮 v0.56.11：新拟物凸面——细边版（边缘环 1.5dp：左上受光、右下背光），
     内芯为表面色，安静不抢戏 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="22dp"
        android:height="22dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="@color/neu_rim_hi"
                android:endColor="@color/neu_rim" />
        </shape>
    </item>
    <item
        android:width="19dp"
        android:height="19dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/neu_bg" />
        </shape>
    </item>
</layer-list>
