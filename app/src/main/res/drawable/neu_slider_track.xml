<?xml version="1.0" encoding="utf-8"?>
<!-- 灵敏度滑轨 v0.56.11：新拟物凹槽——槽底浅深一档，上缘内阴影向下渐隐、下缘内高光向上渐隐；
     进度线本体纯白（档位色由代码 progressTintList 染色：日常品牌蓝 / 9 橙 / 10 红） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <layer-list>
            <!-- 槽底 -->
            <item>
                <shape>
                    <corners android:radius="3dp" />
                    <solid android:color="@color/neu_groove" />
                </shape>
            </item>
            <!-- 上缘内阴影（顶→底渐隐，半强度） -->
            <item>
                <shape>
                    <corners android:radius="3dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#73A3B1C6"
                        android:endColor="#00000000" />
                </shape>
            </item>
            <!-- 下缘内高光（底→顶渐隐） -->
            <item>
                <shape>
                    <corners android:radius="3dp" />
                    <gradient
                        android:angle="90"
                        android:startColor="#40FFFFFF"
                        android:endColor="#00000000" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="3dp" />
                <solid android:color="#FFFFFF" />
            </shape>
        </clip>
    </item>
</layer-list>
