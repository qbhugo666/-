<?xml version="1.0" encoding="utf-8"?>
<!-- 灵敏度滑轨 v0.56.10：新拟物凹槽——槽底深半档，上缘内阴影向下渐隐、下缘内高光向上渐隐；
     进度部分为品牌蓝胶囊线 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <layer-list>
            <!-- 槽底 -->
            <item>
                <shape>
                    <corners android:radius="3dp" />
                    <solid android:color="@color/neu_groove" />
                </shape>
            </item>
            <!-- 上缘内阴影（顶→底渐隐） -->
            <item>
                <shape>
                    <corners android:radius="3dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="@color/neu_lo"
                        android:endColor="#00000000" />
                </shape>
            </item>
            <!-- 下缘内高光（底→顶渐隐） -->
            <item>
                <shape>
                    <corners android:radius="3dp" />
                    <gradient
                        android:angle="90"
                        android:startColor="#66FFFFFF"
                        android:endColor="#00000000" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="3dp" />
                <solid android:color="@color/accent_brand" />
            </shape>
        </clip>
    </item>
</layer-list>
