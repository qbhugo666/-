<?xml version="1.0" encoding="utf-8"?>
<!-- 震动反馈开关圆钮 v0.56.12：白芯凸面钮（边缘环 1.5dp + 纯白内芯）；
     开态白钮压蓝槽、关态白钮压灰槽，状态一目了然 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="20dp"
        android:height="20dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="@color/neu_rim_hi"
                android:endColor="@color/neu_rim" />
        </shape>
    </item>
    <item
        android:width="17dp"
        android:height="17dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
