<?xml version="1.0" encoding="utf-8"?>
<!-- 震动反馈开关轨道 v0.56.12：开=干净的品牌蓝胶囊（白钮压蓝，经典配方）；
     关=新拟物凹槽 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <layer-list>
            <!-- 品牌蓝胶囊 -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <solid android:color="@color/accent_brand" />
                </shape>
            </item>
            <!-- 顶部一层极淡高光，给蓝胶囊一点曲面感 -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#26FFFFFF"
                        android:endColor="#00000000" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <!-- 槽底 -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <solid android:color="@color/neu_groove" />
                </shape>
            </item>
            <!-- 上缘内阴影（顶→底渐隐） -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#73A3B1C6"
                        android:endColor="#00000000" />
                </shape>
            </item>
            <!-- 下缘内高光（底→顶渐隐） -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <gradient
                        android:angle="90"
                        android:startColor="#40FFFFFF"
                        android:endColor="#00000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
