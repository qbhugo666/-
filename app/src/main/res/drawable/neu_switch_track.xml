<?xml version="1.0" encoding="utf-8"?>
<!-- 震动反馈开关轨道 v0.56.11：新拟物双态统一凹槽——
     关=纯凹槽；开=同一凹槽 + 左侧亮一盏品牌蓝指示灯（小面积点缀，不整条染色） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <layer-list>
            <!-- 槽底（与关态同配方） -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <solid android:color="@color/neu_groove" />
                </shape>
            </item>
            <!-- 上缘内阴影（顶→底渐隐） -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#73A3B1C6"
                        android:endColor="#00000000" />
                </shape>
            </item>
            <!-- 下缘内高光（底→顶渐隐） -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <gradient
                        android:angle="90"
                        android:startColor="#40FFFFFF"
                        android:endColor="#00000000" />
                </shape>
            </item>
            <!-- 指示灯：品牌蓝小灯（左空位侧） -->
            <item
                android:width="8dp"
                android:height="8dp"
                android:gravity="left|center_vertical"
                android:left="9dp">
                <shape android:shape="oval">
                    <solid android:color="@color/accent_brand" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <!-- 槽底 -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <solid android:color="@color/neu_groove" />
                </shape>
            </item>
            <!-- 上缘内阴影（顶→底渐隐） -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#73A3B1C6"
                        android:endColor="#00000000" />
                </shape>
            </item>
            <!-- 下缘内高光（底→顶渐隐） -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <gradient
                        android:angle="90"
                        android:startColor="#40FFFFFF"
                        android:endColor="#00000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
