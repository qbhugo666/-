<?xml version="1.0" encoding="utf-8"?>
<!-- 震动反馈开关轨道 v0.56.10：新拟物双态——
     关=凹槽（沉槽：上缘内阴影、下缘内光）；开=凸起品牌蓝胶囊（左上受光边缘） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <layer-list>
            <!-- 受光边缘环 -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="315"
                        android:startColor="@color/neu_rim_hi"
                        android:endColor="@color/neu_rim" />
                </shape>
            </item>
            <!-- 内芯：品牌蓝（内缩 2.5dp） -->
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/accent_brand" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <!-- 槽底 -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/neu_groove" />
                </shape>
            </item>
            <!-- 上缘内阴影（顶→底渐隐） -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="@color/neu_lo"
                        android:endColor="#00000000" />
                </shape>
            </item>
            <!-- 下缘内高光（底→顶渐隐） -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="90"
                        android:startColor="#66FFFFFF"
                        android:endColor="#00000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
