<?xml version="1.0" encoding="utf-8"?>
<!-- 支持作者弹窗 v0.55.14：iOS 卡片式（对齐 指令说明/深色模式 弹窗审美）。
     三通道：爱发电（按钮跳转）+ 微信收款码 + 支付宝收款码（图片供身边人扫）。
     二维码头像已替换为品牌 logo（原图与处理脚本存 design/support）。主界面零新增元素。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp"
        android:text="支持作者"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="请作者喝杯咖啡"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/btn_afdian"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:background="@drawable/btn_round_blue"
                android:text="去爱发电支持"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="微信收款"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/support_qr_wechat" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="支付宝收款"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/support_qr_alipay" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider" />

    <TextView
        android:id="@+id/btn_support_done"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center"
        android:text="完成"
        android:textColor="#0A84FF"
        android:textSize="17sp"
        android:fontFamily="sans-serif-medium"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
