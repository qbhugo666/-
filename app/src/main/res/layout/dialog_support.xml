<?xml version="1.0" encoding="utf-8"?>
<!-- 支持作者弹窗（微信看图式交互）：根布局点击即关（含半透明区域），
     白色卡片可点不穿透，内部按钮/码各管各的。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/support_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 半透明暗色遮罩：点击即关（根布局自身的 click 也走这里） -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000" />

    <!-- 白色圆角卡片：居中，可点不穿透 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog"
        android:paddingBottom="8dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="14dp"
            android:text="支持作者"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/qr_wechat"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"
                    android:src="@drawable/support_qr_wechat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="微信"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/qr_alipay"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"
                    android:src="@drawable/support_qr_alipay" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="支付宝"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/btn_afdian"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:background="@drawable/btn_round_blue"
                    android:text="爱发电"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="爱发电"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btn_support_done"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="完成"
            android:textColor="#0A84FF"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</FrameLayout>
