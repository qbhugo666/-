<?xml version="1.0" encoding="utf-8"?>
<!-- 支持作者弹窗 v0.56.15：新拟物卡（NeuCardView，与主页英雄卡同配方）
     根布局点击即关（含半透明区域），卡片可点不穿透；窗口须全屏（见 showSupportDialog），
     否则窗口外系统压暗 + 窗口内遮罩会叠出"中间一块更黑" -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/support_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 半透明暗色遮罩：整屏均匀一层（窗口自身压暗已在代码里关掉） -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000" />

    <!-- 新拟物凸起卡：居中，可点不穿透 -->
    <com.voicecontrol.app.NeuCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        app:neuCornerRadius="28dp"
        app:neuBlur="12dp"
        app:neuOffset="6dp"
        app:neuLightColor="@color/neu_hi"
        app:neuDarkColor="@color/neu_lo"
        app:neuSurfaceColor="@color/neu_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:text="支持作者"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/qr_wechat"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:background="@drawable/qr_plate"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"
                    android:src="@drawable/support_qr_wechat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="微信"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/qr_alipay"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:background="@drawable/qr_plate"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"
                    android:src="@drawable/support_qr_alipay" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="支付宝"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/btn_afdian"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:gravity="center"
                    android:background="@drawable/btn_round_blue"
                    android:text="爱发电"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="爱发电"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btn_support_done"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="完成"
            android:textColor="@color/accent_brand"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </com.voicecontrol.app.NeuCardView>
</FrameLayout>
