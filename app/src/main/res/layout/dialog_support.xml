<?xml version="1.0" encoding="utf-8"?>
<!-- 支持作者弹窗 v0.56.16：浮起式干净卡片（白卡+真实投影）。
     注：弹窗底下有暗遮罩，背景≠卡片同色，新拟物"同色浮雕"在此失效
     （会退化成白光晕）——弹窗走 iOS 浮卡路线，新拟物保留给页面内卡片。
     根布局点击即关，卡片可点不穿透。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/support_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 半透明暗色遮罩：整屏均匀一层（窗口自身压暗已在代码里关掉） -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000" />

    <!-- 浮起卡片：居中，可点不穿透 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog"
        android:elevation="16dp"
        android:paddingBottom="6dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="20dp"
            android:text="支持作者"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/qr_wechat"
                    android:layout_width="match_parent"
                    android:layout_height="106dp"
                    android:background="@drawable/qr_plate"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"
                    android:src="@drawable/support_qr_wechat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="微信"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/qr_alipay"
                    android:layout_width="match_parent"
                    android:layout_height="106dp"
                    android:background="@drawable/qr_plate"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"
                    android:src="@drawable/support_qr_alipay" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="支付宝"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/btn_afdian"
                    android:layout_width="match_parent"
                    android:layout_height="106dp"
                    android:gravity="center"
                    android:background="@drawable/btn_round_blue"
                    android:text="爱发电"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="爱发电"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="18dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/btn_support_done"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="完成"
            android:textColor="@color/accent_brand"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</FrameLayout>
